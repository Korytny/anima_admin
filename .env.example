# ═══ Anima Admin — шаблон окружения. Скопировать в .env.local и заполнить (.env.local в git не попадает)
# После правки — перезапустить npm run dev (VITE_-переменные читаются при старте).

# ── Supabase ───────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# service_role — только для scripts/db.mts (Claude Code пишет промпты агентов). Без VITE_: во фронтенд не попадает
SUPABASE_SERVICE_ROLE_KEY=

# ── n8n: вебхуки шагов конвейера ───────────────────────────
# Значение — только id вебхука (последняя часть адреса …/webhook/<id>). Админка шлёт только id записей,
# данные n8n берёт из БД сам. Запросы идут через dev-прокси /n8n → N8N_URL (без CORS).
# Режим: test → /webhook-test/<id> (в n8n нажать «Listen for test event»), prod → /webhook/<id> (поток активирован).
N8N_URL=http://localhost:5678
VITE_N8N_MODE=prod
# Шаг               | Переменная               | Тело запроса из админки                                   | Что пишет n8n
# кадр шота         | VITE_N8N_IMAGE_WEBHOOK   | {action:'scene_image', scene_id, topic_id}                 | scenes.base_image_url, char_img_url, status
# сценарий серии    | VITE_N8N_SCRIPT_WEBHOOK  | {action:'episode_script', topic_id}                        | topics.script_scenas
# озвучка шота      | VITE_N8N_AUDIO_WEBHOOK   | {action:'scene_audio', scene_id}                           | scenes.audio_file, audio_duration
# видео шота        | VITE_N8N_VIDEO_WEBHOOK   | {action:'scene_video', scene_id}                           | scenes.video_file, video_sub
# музыка локации    | VITE_N8N_MUSIC_WEBHOOK   | {action:'location_music', topic_id, location_num, scene_ids} | scenes.music_file
# монтаж серии      | VITE_N8N_MONTAGE_WEBHOOK | {action:'episode_montage', topic_id}                       | topics.url_final
VITE_N8N_IMAGE_WEBHOOK=
VITE_N8N_SCRIPT_WEBHOOK=
VITE_N8N_AUDIO_WEBHOOK=
VITE_N8N_VIDEO_WEBHOOK=
VITE_N8N_MUSIC_WEBHOOK=
VITE_N8N_MONTAGE_WEBHOOK=

# ── Медиа: папка с генерациями (ComfyUI/output) отдаётся по /media ──
MEDIA_DIR=
VITE_MEDIA_BASE_URL=/media

# ── ComfyUI и вычисления ───────────────────────────────────
# Картинки напрямую из ComfyUI (если он на другой машине). Пример: http://192.168.1.50:8188
VITE_COMFY_URL=
# Серверы генерации (страница «Вычисления»): «название|адрес ComfyUI|для чего|$ в час», несколько — через «;»
COMPUTE_SERVERS=
# RunPod — страница «Вычисления». Без VITE_: остаётся на сервере
RUNPOD_API_KEY=

# ── Ассистент админки (OpenAI, Responses API). Без VITE_: остаётся на сервере ──
OPENAI_API_KEY=
